# Copy to local/sidecar.env on the computer running the backend.
# Set the actual Orange Pi address and the same secret used on the board.
SIDECAR_URL=http://192.168.137.100:8787
SIDECAR_TOKEN=replace-with-the-existing-board-secret
UNO_PORT=COM9
UNO_BAUD=115200
UNO_DEVICE_ID=uno-soil-rain
UNO_SERIAL_ENABLED=1
